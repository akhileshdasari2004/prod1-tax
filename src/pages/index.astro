---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeHero from '../components/home/HomeHero.astro';
import CategoryShowcase from '../components/home/CategoryShowcase.astro';
import FeaturedCalculators from '../components/home/FeaturedCalculators.astro';
import WhySection from '../components/home/WhySection.astro';
import HomeSeoArticle from '../components/home/HomeSeoArticle.astro';
import HomeFaqPreview from '../components/home/HomeFaqPreview.astro';
import AllCalculatorsSection from '../components/home/AllCalculatorsSection.astro';
import TrustBar from '../components/home/TrustBar.astro';
import { homeFaqPreview } from '../config/homepage';
import { homePageJsonLd } from '../lib/schema';

const pathname = '/';

const metaDescription =
  'Free financial calculators for investing, loans, and taxes. Fast, accurate, private tools with no registration — built for clarity.';

const jsonLd = homePageJsonLd({
  title: 'Financial calculators designed for clarity 🤚',
  description: metaDescription,
  faqs: homeFaqPreview,
});
---

<BaseLayout
  title="Financial calculators designed for clarity 🤚"
  description={metaDescription}
  pathname={pathname}
  jsonLd={jsonLd}
>
  <HomeHero />
  <CategoryShowcase />
  <FeaturedCalculators />
  <WhySection />
  <TrustBar />
  <HomeSeoArticle />
  <HomeFaqPreview />
  <AllCalculatorsSection />
</BaseLayout>
