---
import { homeFaqPreview } from '../../config/homepage';
---

<section class="mt-24" aria-labelledby="home-faq-heading">
  <div class="prose-width">
    <h2 id="home-faq-heading" class="text-title-2 text-balance">Frequently asked questions</h2>
    <p class="text-body mt-3">Straight answers about how our tools work, what we do not provide, and how to use results responsibly.</p>
  </div>

  <div class="mt-8 space-y-3">
    {
      homeFaqPreview.map((item) => (
        <details class="faq-item group">
          <summary>
            <span class="flex items-center justify-between gap-6">
              <span class="text-body font-medium" style="color: var(--text-primary);">
                {item.question}
              </span>
              <span
                class="shrink-0 text-body-sm transition-transform duration-[var(--duration-normal)] group-open:rotate-180"
                style="color: var(--text-tertiary);"
                aria-hidden="true"
              >
                ▾
              </span>
            </span>
          </summary>
          <p class="text-body mt-5">{item.answer}</p>
        </details>
      ))
    }
  </div>
</section>
