---
import { homeHero } from '../../config/homepage';

const { eyebrow, headline, subheadline, ctaLabel, ctaHref } = homeHero;
---

<section class="relative" aria-labelledby="home-hero-heading">
  <div class="prose-width">
    <p class="text-eyebrow animate-in">{eyebrow}</p>
    <h1 id="home-hero-heading" class="text-display mt-4 text-balance animate-in animate-in-delay-1">
      {headline}
    </h1>
    <p class="text-body-lg mt-6 max-w-2xl text-balance animate-in animate-in-delay-2">
      {subheadline}
    </p>
    <div class="mt-10 flex flex-wrap items-center gap-4 animate-in animate-in-delay-2">
      <a href={ctaHref} class="btn-primary">
        {ctaLabel}
      </a>
      <a href="/about" class="btn-ghost">
        How we build tools
      </a>
    </div>
  </div>
</section>
