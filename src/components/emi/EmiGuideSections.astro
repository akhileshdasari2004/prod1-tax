---
import {
  emiFormula,
  emiExample,
  emiBenefits,
  emiGuideSections,
} from '../../content/emi-calculator-page';
---

<div class="mt-24 max-w-3xl">
  <section id="formula" class="scroll-mt-28">
    <h2 class="text-title-2 text-balance">{emiFormula.title}</h2>
    <p class="text-body mt-4">{emiFormula.summary}</p>
    <div
      class="mt-6 rounded-2xl border px-6 py-5 font-mono text-body-sm"
      style="border-color: var(--border-subtle); background: var(--bg-secondary); color: var(--text-primary);"
    >
      {emiFormula.formula}
    </div>
    <ul class="mt-6 list-none space-y-3 p-0">
      {
        emiFormula.definitions.map((row) => (
          <li class="flex gap-3 text-body-sm">
            <span class="shrink-0 font-semibold" style="color: var(--text-primary);">{row.symbol}</span>
            <span>{row.meaning}</span>
          </li>
        ))
      }
    </ul>
    <ul class="mt-6 list-disc space-y-2 pl-6 text-body">
      {emiFormula.notes.map((note) => (
        <li>{note}</li>
      ))}
    </ul>
  </section>

  <section id="example" class="mt-20 scroll-mt-28">
    <h2 class="text-title-2 text-balance">{emiExample.title}</h2>
    <p class="text-body mt-4">
      Suppose you borrow <strong>${emiExample.inputs.principal.toLocaleString()}</strong> at{' '}
      <strong>{emiExample.inputs.rate}%</strong> annual interest for{' '}
      <strong>{emiExample.inputs.years} years</strong>:
    </p>
    <ol class="mt-6 list-decimal space-y-3 pl-6 text-body">
      {emiExample.steps.map((step) => (
        <li>{step}</li>
      ))}
    </ol>
    <p class="text-caption mt-6">{emiExample.disclaimer}</p>
  </section>

  <section id="benefits" class="mt-20 scroll-mt-28">
    <h2 class="text-title-2 text-balance">{emiBenefits.title}</h2>
    <ul class="mt-8 space-y-8">
      {
        emiBenefits.items.map((item) => (
          <li>
            <h3 class="text-title-4">{item.heading}</h3>
            <p class="text-body mt-2">{item.body}</p>
          </li>
        ))
      }
    </ul>
  </section>

  {
    emiGuideSections.map((section) => (
      <section id={section.id} class="mt-16 scroll-mt-28">
        <h2 class="text-title-3 text-balance">{section.heading}</h2>
        {section.paragraphs.map((p) => (
          <p class="text-body mt-4">{p}</p>
        ))}
      </section>
    ))
  }
</div>
