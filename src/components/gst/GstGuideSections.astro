---
import {
  gstFormula,
  gstExamples,
  gstBenefits,
  gstGuideSections,
} from '../../content/gst-calculator-page';
---

<div class="mt-24 max-w-3xl">
  <section id="formula" class="scroll-mt-28">
    <h2 class="text-title-2 text-balance">{gstFormula.title}</h2>
    <p class="text-body mt-4">{gstFormula.summary}</p>

    <div class="mt-8 space-y-6">
      <div>
        <h3 class="text-title-4">Add GST (exclusive → inclusive)</h3>
        <div
          class="mt-3 rounded-2xl border px-6 py-4 font-mono text-body-sm space-y-2"
          style="border-color: var(--border-subtle); background: var(--bg-secondary); color: var(--text-primary);"
        >
          <p>{gstFormula.addFormula}</p>
          <p>{gstFormula.addFinal}</p>
        </div>
      </div>
      <div>
        <h3 class="text-title-4">Remove GST (inclusive → exclusive)</h3>
        <div
          class="mt-3 rounded-2xl border px-6 py-4 font-mono text-body-sm space-y-2"
          style="border-color: var(--border-subtle); background: var(--bg-secondary); color: var(--text-primary);"
        >
          <p>{gstFormula.removeFormula}</p>
          <p>{gstFormula.removeGst}</p>
          <p>{gstFormula.removeFinal}</p>
        </div>
      </div>
    </div>

    <ul class="mt-6 list-disc space-y-2 pl-6 text-body">
      {gstFormula.notes.map((note) => (
        <li>{note}</li>
      ))}
    </ul>
  </section>

  {
    gstExamples.map((example) => (
      <section id={`example-${example.mode}`} class="mt-20 scroll-mt-28">
        <h2 class="text-title-2 text-balance">{example.title}</h2>
        <ol class="mt-6 list-decimal space-y-3 pl-6 text-body">
          {example.steps.map((step) => (
            <li>{step}</li>
          ))}
        </ol>
      </section>
    ))
  }

  <section id="benefits" class="mt-20 scroll-mt-28">
    <h2 class="text-title-2 text-balance">{gstBenefits.title}</h2>
    <ul class="mt-8 space-y-8">
      {
        gstBenefits.items.map((item) => (
          <li>
            <h3 class="text-title-4">{item.heading}</h3>
            <p class="text-body mt-2">{item.body}</p>
          </li>
        ))
      }
    </ul>
  </section>

  {
    gstGuideSections.map((section) => (
      <section id={section.id} class="mt-16 scroll-mt-28">
        <h2 class="text-title-3 text-balance">{section.heading}</h2>
        {section.paragraphs.map((p) => (
          <p class="text-body mt-4">{p}</p>
        ))}
      </section>
    ))
  }
</div>
