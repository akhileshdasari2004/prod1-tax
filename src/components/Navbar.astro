---
import { SITE } from '../config/site';
import { primaryNav } from '../config/navigation';
import CurrencySelector from './CurrencySelector.astro';
import ThemeToggle from './ThemeToggle.astro';

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

function isActive(href: string): boolean {
  if (href === '/') return currentPath === '/';
  return currentPath === href || currentPath.startsWith(`${href}/`);
}
---

<header id="site-header" class="site-header">
  <a
    href="#main-content"
    class="sr-only focus:not-sr-only focus:absolute focus:left-6 focus:top-4 focus:z-[60] focus:rounded-full focus:px-5 focus:py-2.5 focus:text-sm focus:font-medium"
    style="background: var(--cta); color: var(--cta-text);"
  >
    Skip to main content
  </a>
  <div class="container-page flex h-[52px] items-center justify-between gap-4 sm:h-14">
    <a
      href="/"
      class="flex items-center gap-3 font-semibold transition-opacity hover:opacity-80"
      style="color: var(--text-primary);"
    >
      <span
        class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg text-xs font-semibold"
        style="background: var(--cta); color: var(--cta-text);"
        aria-hidden="true"
      >
        FT
      </span>
      <span class="text-body-sm">{SITE.name}</span>
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label="Primary">
      {
        primaryNav.map((item) => (
          <a
            href={item.href}
            class="link-nav"
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <CurrencySelector />
      <ThemeToggle />
      <button
        type="button"
        id="mobile-menu-button"
        class="btn-secondary min-h-10 min-w-10 px-0 md:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open menu"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden border-t md:hidden" style="border-color: var(--border-subtle);" hidden>
    <nav class="container-page flex flex-col gap-1 py-4" aria-label="Mobile primary">
      <div class="mb-3 md:hidden">
        <CurrencySelector id="currency-select-mobile" showLabel />
      </div>
      {
        primaryNav.map((item) => (
          <a
            href={item.href}
            class="link-nav w-fit"
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<script>
  const header = document.getElementById('site-header');
  const button = document.getElementById('mobile-menu-button');
  const menu = document.getElementById('mobile-menu');

  const onScroll = () => {
    if (!header) return;
    header.classList.toggle('is-scrolled', window.scrollY > 4);
  };

  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  button?.addEventListener('click', () => {
    const expanded = button.getAttribute('aria-expanded') === 'true';
    button.setAttribute('aria-expanded', String(!expanded));
    button.setAttribute('aria-label', expanded ? 'Open menu' : 'Close menu');
    menu?.classList.toggle('hidden');
    menu?.toggleAttribute('hidden');
  });
</script>
