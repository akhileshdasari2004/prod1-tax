---
import { aboutTimelineItems } from '../../content/about-timeline';

const statusLabel: Record<string, string> = {
  completed: 'Established',
  current: 'Active',
  upcoming: 'Important',
};
---

<ol class="about-timeline mx-auto mt-4 max-w-4xl list-none px-4 sm:px-6" aria-label="About RealFinanceTools">
  {
    aboutTimelineItems.map((item) => (
      <li class="about-timeline__item">
        <div class="about-timeline__marker" aria-hidden="true">
          <span class="about-timeline__dot" />
        </div>
        <article class="card about-timeline__card">
          <div class="flex flex-wrap items-start justify-between gap-3">
            <div>
              <p class="text-caption" style="color: var(--text-tertiary);">
                {item.category}
              </p>
              <h2 class="text-title-4 mt-1">{item.title}</h2>
            </div>
            <span class="about-timeline__badge" data-status={item.status}>
              {statusLabel[item.status]}
            </span>
          </div>
          <p class="text-body mt-4">{item.description}</p>
        </article>
      </li>
    ))
  }
</ol>

<style>
  .about-timeline {
    position: relative;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .about-timeline__item {
    position: relative;
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: var(--space-4);
    padding-left: 0;
  }

  .about-timeline__marker {
    display: flex;
    justify-content: center;
    padding-top: var(--space-6);
  }

  .about-timeline__dot {
    width: 0.75rem;
    height: 0.75rem;
    border-radius: var(--radius-full);
    background: var(--accent);
    box-shadow: 0 0 0 3px var(--bg-primary);
  }

  .about-timeline__item:not(:last-child) .about-timeline__marker::after {
    content: '';
    position: absolute;
    left: 1.2rem;
    top: 2.5rem;
    bottom: calc(-1 * var(--space-8));
    width: 1px;
    background: var(--border-default);
  }

  .about-timeline__badge {
    font-size: var(--text-caption-size);
    font-weight: 600;
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-full);
    border: 1px solid var(--border-default);
    color: var(--text-secondary);
    background: var(--bg-secondary);
  }

  .about-timeline__badge[data-status='completed'] {
    color: var(--success);
    border-color: color-mix(in srgb, var(--success) 35%, transparent);
    background: color-mix(in srgb, var(--success) 12%, transparent);
  }

  .about-timeline__badge[data-status='current'] {
    color: var(--accent);
    border-color: color-mix(in srgb, var(--accent) 35%, transparent);
    background: var(--accent-muted);
  }

  .about-timeline__badge[data-status='upcoming'] {
    color: var(--warning);
    border-color: color-mix(in srgb, var(--warning) 35%, transparent);
    background: color-mix(in srgb, var(--warning) 12%, transparent);
  }
</style>
