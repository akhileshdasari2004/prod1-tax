---
import Breadcrumbs, { type BreadcrumbItem } from './Breadcrumbs.astro';
import FAQSection, { type FAQItem } from './FAQSection.astro';
import RelatedCalculators from './RelatedCalculators.astro';
import type { CalculatorMeta } from '../config/calculators';

interface Props {
  title: string;
  description: string;
  breadcrumbs: BreadcrumbItem[];
  faq?: FAQItem[];
  related?: CalculatorMeta[];
  lastUpdated?: string;
}

const {
  title,
  description,
  breadcrumbs,
  faq = [],
  related = [],
  lastUpdated,
} = Astro.props;
---

<article>
  <Breadcrumbs items={breadcrumbs} />

  <header class="prose-width animate-in animate-in-delay-1">
    <h1 class="text-display text-balance">{title}</h1>
    <p class="text-body-lg mt-5">{description}</p>
    {
      lastUpdated && (
        <p class="text-caption mt-4">
          Last updated: <time datetime={lastUpdated}>{lastUpdated}</time>
        </p>
      )
    }
  </header>

  <div class="mt-12 grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(280px,340px)] lg:gap-12">
    <div class="min-w-0 animate-in animate-in-delay-2">
      <slot />
    </div>
    <aside class="lg:sticky lg:top-24 lg:self-start" aria-label="Calculation results">
      <slot name="results" />
    </aside>
  </div>

  {faq.length > 0 && <FAQSection items={faq} />}
  {related.length > 0 && <RelatedCalculators calculators={related} />}
</article>
