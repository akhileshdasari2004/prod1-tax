# Copy to .env for local builds (optional). Set the same keys in Cloudflare Pages → Settings → Environment variables.

# Production only — leave empty in Preview to disable indexing and analytics.
PUBLIC_GA_MEASUREMENT_ID=
PUBLIC_GOOGLE_SITE_VERIFICATION=
PUBLIC_BING_SITE_VERIFICATION=

# "false" on Preview deployments (*.pages.dev) — "true" or unset on Production.
PUBLIC_INDEXABLE=true
